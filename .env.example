# Файл с инцидентами (формат МТС как есть). Путь относительно корня репозитория или абсолютный.
INCIDENTS_FILE=data/incidents.json

# Ссылка в ITSM. Подстановки: {id}, {sysId}
ITSM_URL_TEMPLATE=/itsm/{id}

# Время: export — «сейчас» стартует с момента выгрузки (самая поздняя дата в файле) и дальше тикает;
#        real   — реальное системное время.
TIME_MODE=export
# Можно задать момент выгрузки вручную (ISO, UTC), иначе берётся из файла
# EXPORT_NOW=2026-11-10T21:00:00Z

# Как часто перечитывать файл, секунды
POLL_INTERVAL=0.5

# ИИ: rules | gigachat
LLM_PROVIDER=rules
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Сертификат Минцифры (Russian Trusted Root CA, PEM) — нужен для TLS к GigaChat
GIGACHAT_CA_BUNDLE=certs/russian_trusted_root_ca.cer
